---
import Base from '../layouts/Base.astro';
import { NOTICES_ENDPOINT } from '../config.ts';

const title = 'Chicago Notice to Mariners · lancha boat';
const description =
  'Current U.S. Coast Guard Broadcast Notices to Mariners, filtered for Chicago boaters: the harbors, the lakefront, and the Chicago River. Check before you leave the dock.';
---
<Base title={title} description={description}>
  <section class="wrap intro-sec">
    <p class="kicker">Chicago · Lake Michigan</p>
    <h1>Notice to Mariners</h1>
    <p class="lede">Current U.S. Coast Guard navigation notices, filtered to what matters
      for boating around Chicago. Check them before you leave the dock.</p>
  </section>

  <section class="wrap">
    <div class="card notice-box">
      <!-- intro callout -->
      <div class="callout">
        <p class="callout-head">What this is</p>
        <p class="callout-body">An aggregated feed of Coast Guard and Chicago Harbor Safety Committee notices,
          filtered down to the water we actually run — Chicago's harbors, the lakefront, and the river. The
          official Notices to Mariners cover the entire Great Lakes; they're so broad that most boaters never
          read them. This strips it to what's relevant here, refreshed every 15 minutes, so you can check it
          in ten seconds before you leave the dock.</p>
        <p class="callout-fine">
          BNM (Broadcast Notice to Mariners): time-sensitive Coast Guard navigation and safety notices.<br />
          LNM (Local Notice to Mariners): the Coast Guard's weekly navigation roundup.<br />
          Harbor: Chicago Harbor Safety Committee posts on boat runs, bridge lifts, and projects.
        </p>
        <p class="callout-fine muted">Independent aggregator. Always verify critical navigation information with
          <a href="https://www.navcen.uscg.gov/" target="_blank" rel="noopener">official U.S. Coast Guard sources</a>.</p>
      </div>

      <!-- filters -->
      <div class="filters" id="filters">
        <button class="nfilter is-on" data-src="all" type="button">All</button>
        <button class="nfilter" data-src="BNM" type="button">BNM</button>
        <button class="nfilter" data-src="LNM" type="button">LNM</button>
        <button class="nfilter" data-src="CHSC" type="button">Harbor</button>
        <span class="updated muted" id="updated"></span>
      </div>

      <!-- feed -->
      <div class="notice-feed" id="feed">
        <p class="feed-msg muted" id="feed-msg">Loading current Chicago notices…</p>
      </div>

      <!-- credit -->
      <p class="notice-credit">Brought to you by
        <a href="https://www.instagram.com/luisvecchio/" target="_blank" rel="noopener">Capt. Luis G. Vecchio</a>
        &amp; <a href="https://www.instagram.com/lanchaboats/" target="_blank" rel="noopener">LanchaBoats</a></p>
    </div>
    <div class="cta-row"><a class="btn" href="/book">Check dates &amp; book →</a></div>
  </section>

  <script define:vars={{ NOTICES_ENDPOINT }}>
    const feed = document.getElementById('feed');
    const feedMsg = document.getElementById('feed-msg');
    const updatedEl = document.getElementById('updated');
    const filters = document.getElementById('filters');
    let ALL = [];
    let current = 'all';

    const tz = 'America/Chicago';
    const dtf = new Intl.DateTimeFormat('en-US', { timeZone: tz, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
    const dayf = new Intl.DateTimeFormat('en-US', { timeZone: tz, month: 'short', day: 'numeric' });

    function ago(iso) {
      if (!iso) return '';
      const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
      if (s < 90) return 'just now';
      if (s < 3600) return Math.round(s / 60) + ' min ago';
      if (s < 86400) return Math.round(s / 3600) + ' hr ago';
      return Math.round(s / 86400) + ' d ago';
    }
    const esc = (s) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    function render() {
      const list = current === 'all' ? ALL : ALL.filter((n) => n.source === current);
      if (!ALL.length) {
        feed.innerHTML = `<div class="empty"><p class="empty-h">All clear on Chicago waters</p>
          <p class="muted">We checked the last 30 days of notices, and none touch Chicago's harbors, the lakefront, or the river.</p>
          <p><a href="https://www.navcen.uscg.gov/broadcast-notice-to-mariners" target="_blank" rel="noopener">Check the official Coast Guard notices →</a></p></div>`;
        return;
      }
      if (!list.length) {
        const lbl = current === 'CHSC' ? 'Harbor' : current;
        feed.innerHTML = `<p class="feed-msg muted">Nothing under ${lbl} right now. Tap All to see every notice.</p>`; return;
      }
      feed.innerHTML = list.map((n) => {
        let when = '';
        try { when = dtf.format(new Date(n.publishedAt)); } catch (e) {}
        const badge = n.source === 'CHSC' ? 'Harbor' : (n.source === 'LNM' ? 'LNM' : 'BNM');
        const cat = n.category ? ` · ${esc(n.category)}` : '';
        const cancelled = n.status === 'cancelled';
        return `<article class="notice${cancelled ? ' is-cancelled' : ''}">
          <h3>${esc(n.title)}</h3>
          <p class="notice-meta"><span class="src ${badge.toLowerCase()}">${badge}</span>${cat} · ${esc(when)}${cancelled ? ' · <span class="canc-badge">Cancelled</span>' : ''}</p>
          ${n.summary ? `<p class="notice-sum">${esc(n.summary)}</p>` : ''}
          ${n.area ? `<p class="notice-area"><span>Area</span> ${esc(n.area)}</p>` : ''}
          ${n.officialUrl ? `<a class="notice-link" href="${esc(n.officialUrl)}" target="_blank" rel="noopener">View official notice →</a>` : ''}
        </article>`;
      }).join('');
    }

    filters.addEventListener('click', (e) => {
      const b = e.target.closest('.nfilter'); if (!b) return;
      current = b.dataset.src;
      [...filters.querySelectorAll('.nfilter')].forEach((x) => x.classList.toggle('is-on', x === b));
      render();
    });

    (async () => {
      if (!NOTICES_ENDPOINT) {
        feedMsg.innerHTML = `This feed is being set up. In the meantime, check the
          <a href="https://www.navcen.uscg.gov/broadcast-notice-to-mariners" target="_blank" rel="noopener">official Coast Guard notices</a>.`;
        return;
      }
      try {
        const res = await fetch(`${NOTICES_ENDPOINT}?action=notices`, { method: 'GET' });
        const data = await res.json();
        ALL = (data && data.notices) || [];
        updatedEl.textContent = data && data.updated ? `Updated ${ago(data.updated)}` : '';
        render();
      } catch (err) {
        feedMsg.innerHTML = `The live feed is slow to respond right now. In the meantime, check the
          <a href="https://www.navcen.uscg.gov/broadcast-notice-to-mariners" target="_blank" rel="noopener">official Coast Guard source</a>.`;
      }
    })();
  </script>

  <style>
    .intro-sec { margin-top: 48px; }
    .kicker { text-transform: uppercase; letter-spacing: .18em; font-weight: 700; font-size: 13px; color: var(--blue); margin: 0 0 12px; }
    h1 { font-size: clamp(36px, 6vw, 64px); font-weight: 800; }
    .lede { font-size: 19px; max-width: 640px; }

    .notice-box { margin: 18px 0 8px; padding: 0; overflow: hidden; }
    .callout { padding: 22px 24px 18px; border-bottom: 2px solid var(--ink); background: #fbfaf0; }
    .callout-head { font-family: var(--display); font-weight: 800; font-size: 20px; margin: 0 0 8px; }
    .callout-body { font-size: 15px; line-height: 1.55; margin: 0 0 10px; max-width: 720px; }
    .callout-fine { font-size: 13px; line-height: 1.5; margin: 0 0 6px; }
    .cta-row { margin: 28px 0 0; }
    .callout-fine:last-child { margin-bottom: 0; }

    .filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 14px 24px; border-bottom: 2px solid var(--line); }
    .nfilter { font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: .04em;
               padding: 6px 15px; border-radius: 999px; border: 2px solid var(--ink); background: var(--cream);
               color: var(--ink); cursor: pointer; }
    .nfilter.is-on { background: var(--blue); color: var(--cream); }
    .updated { margin-left: auto; font-size: 12px; }

    .notice-feed { max-height: 620px; overflow-y: auto; padding: 6px 24px 14px; }

    .notice-credit { padding: 16px 24px; border-top: 2px solid var(--line); background: #fbfaf0;
                     font-size: 14px; color: #6f6a58; margin: 0; text-align: center; }
    .notice-credit a { font-weight: 700; color: var(--blue); text-decoration: none; border-bottom: 2px solid transparent; }
    .notice-credit a:hover { border-bottom-color: var(--blue); }

    @media (max-width: 640px) {
      .callout, .filters, .notice-feed, .notice-credit { padding-left: 16px; padding-right: 16px; }
      .notice-feed { max-height: none; } /* natural scroll on phones */
      .updated { margin-left: 0; width: 100%; }
    }
  </style>

  <!-- Feed cards are injected at runtime via innerHTML, so they never receive
       Astro's scoping attribute. These rules must be global to reach them. -->
  <style is:global>
    #feed .feed-msg { padding: 26px 0; text-align: center; }
    #feed .notice { padding: 16px 0; border-bottom: 1px solid var(--line); }
    #feed .notice:last-child { border-bottom: none; }
    #feed .notice h3 { font-size: 18px; font-weight: 800; margin: 0 0 6px; line-height: 1.2; }
    #feed .notice-meta { font-size: 12px; color: #8a8470; margin: 0 0 8px; display: flex; align-items: center; gap: 2px; flex-wrap: wrap; }
    #feed .src { font-family: var(--display); font-weight: 700; font-size: 11px; letter-spacing: .05em;
                 padding: 2px 8px; border-radius: 999px; border: 2px solid var(--ink); margin-right: 6px; }
    #feed .src.bnm { background: var(--magenta); color: var(--cream); }
    #feed .src.lnm { background: var(--gold); color: var(--ink); }
    #feed .src.harbor { background: var(--blue); color: var(--cream); }
    #feed .notice-sum { font-size: 14px; line-height: 1.55; margin: 0 0 8px; }
    #feed .notice-area { font-size: 13px; margin: 0 0 8px; color: var(--ink); }
    #feed .notice-area span { font-weight: 700; text-transform: uppercase; letter-spacing: .06em; font-size: 11px; color: #8a8470; margin-right: 4px; }
    #feed .notice-link { font-weight: 700; font-size: 14px; color: var(--blue); }
    #feed .notice.is-cancelled { opacity: .66; }
    #feed .notice.is-cancelled h3 { text-decoration: line-through; text-decoration-thickness: 2px; text-decoration-color: #b23a3a; }
    #feed .canc-badge { font-family: var(--display); font-weight: 700; font-size: 11px; letter-spacing: .05em; text-transform: uppercase;
                        color: #b23a3a; border: 2px solid #b23a3a; border-radius: 999px; padding: 1px 8px; margin-left: 2px; }
    #feed .empty { padding: 34px 8px; text-align: center; }
    #feed .empty-h { font-family: var(--display); font-weight: 800; font-size: 20px; margin: 0 0 6px; }
    #feed .muted { color: #8a8470; }
  </style>
</Base>
