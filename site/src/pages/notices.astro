---
import Base from '../layouts/Base.astro';
import { NOTICES_ENDPOINT } from '../config.ts';

const title = 'Chicago Notice to Mariners · lancha boat';
const description =
  'U.S. Coast Guard and Chicago Harbor Safety Committee notices for Chicago boaters, covering the harbors, the lakefront, and the Chicago River. Refreshed every 15 minutes.';
---
<Base title={title} description={description}>
  <section class="wrap intro-sec">
    <p class="kicker">Chicago · Lake Michigan</p>
    <h1>Notice to Mariners</h1>
    <p class="lede">Safety zones, lock closures, dark lights, and river events on Chicago waters,
      in one list you can read in ten seconds before you leave the dock.</p>
    <p class="hero-credit">Brought to you by
      <a href="https://www.instagram.com/luisvecchio/" target="_blank" rel="noopener">Luis</a> and Shir</p>
  </section>

  <section class="wrap">
    <div class="card notice-box">
      <!-- intro callout -->
      <div class="callout">
        <p class="callout-head">Why this page exists</p>
        <p class="callout-body">The U.S. Coast Guard publishes navigation notices for the entire Great Lakes,
          so the few that matter in Chicago get buried. This page keeps only the ones that touch the water
          we run: Chicago's harbors, the lakefront, and the river. It adds the Chicago Harbor Safety
          Committee's posts and refreshes every 15 minutes.</p>
        <p class="callout-fine">
          BNM (Broadcast Notice to Mariners): time-sensitive Coast Guard safety notices.<br />
          LNM (Local Notice to Mariners): the Coast Guard's weekly navigation roundup.<br />
          Harbor: Chicago Harbor Safety Committee posts on boat runs, bridge lifts, and projects.
        </p>
        <p class="callout-fine muted">lancha boat runs this page independently of the U.S. Coast Guard.
          Always confirm critical navigation information with
          <a href="https://www.navcen.uscg.gov/" target="_blank" rel="noopener">official Coast Guard sources</a>.</p>
      </div>

      <!-- filters -->
      <div class="filters" id="filters">
        <button class="nfilter is-on" data-src="all" type="button">All</button>
        <button class="nfilter" data-src="BNM" type="button">BNM</button>
        <button class="nfilter" data-src="LNM" type="button">LNM</button>
        <button class="nfilter" data-src="CHSC" type="button">Harbor</button>
        <span class="updated muted" id="updated"></span>
      </div>

      <!-- feed -->
      <div class="notice-feed" id="feed">
        <p class="feed-msg muted" id="feed-msg">Loading current Chicago notices…</p>
      </div>
    </div>
    <div class="cta-row">
      <p class="cta-line">Water looks good? Grab your crew and get out there.</p>
      <a class="btn" href="/book">Check dates &amp; book →</a>
    </div>
  </section>

  <script define:vars={{ NOTICES_ENDPOINT }}>
    const feed = document.getElementById('feed');
    const feedMsg = document.getElementById('feed-msg');
    const updatedEl = document.getElementById('updated');
    const filters = document.getElementById('filters');
    let ALL = [];
    let current = 'all';

    const tz = 'America/Chicago';
    const dtf = new Intl.DateTimeFormat('en-US', { timeZone: tz, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
    const dayf = new Intl.DateTimeFormat('en-US', { timeZone: tz, month: 'short', day: 'numeric' });

    function ago(iso) {
      if (!iso) return '';
      const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
      if (s < 90) return 'just now';
      if (s < 3600) return Math.round(s / 60) + ' min ago';
      if (s < 86400) return Math.round(s / 3600) + ' hr ago';
      return Math.round(s / 86400) + ' d ago';
    }
    const esc = (s) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    // ── Readability: the Coast Guard feed arrives in all caps, numbered, and
    // signed off with "BT". Everything below turns it into plain sentences.
    const MONTHS = ['january','february','march','april','may','june','july','august','september','october','november','december'];
    const DAYS = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
    const ALWAYS = { 'coast guard': 'Coast Guard', 'us army corps of engineers': 'U.S. Army Corps of Engineers',
      'army corps of engineers': 'Army Corps of Engineers', 'lake michigan': 'Lake Michigan', 'great lakes': 'Great Lakes',
      'michigan city': 'Michigan City', 'chicago': 'Chicago', 'illinois': 'Illinois', 'indiana': 'Indiana', 'wisconsin': 'Wisconsin' };
    const TYPOS = { exstinguished: 'extinguished', constructon: 'construction', occuring: 'occurring', amtrack: 'Amtrak' };
    // A run of words ending in one of these is a place name ("wilson avenue breakwater light").
    const PLACE_END = 'street|st|avenue|ave|bridge|beach|harbor|river|branch|lock|point|park|light|breakwater|canal|island|riverwalk|pier';
    const STOP = new Set(['the','of','a','an','at','on','in','and','near','from','to','between','by','for','into','with','will','be','is','has','that','this','their','its','over','under','across','along']);
    const cap = (w) => w.charAt(0).toUpperCase() + w.slice(1);

    function tidy(raw) {
      let t = (raw || '').replace(/^\s*\d+\.\s*/, '').replace(/\s*\bBT\b\s*(…?)\s*$/, '$1').trim();
      if (t !== t.toUpperCase()) return t; // already human-written (Harbor posts)
      t = t.toLowerCase().replace(/\b[a-z]+\b/g, (w) => TYPOS[w] || w);
      t = t.replace(new RegExp(`\\b(${MONTHS.concat(DAYS).join('|')})\\b`, 'g'), cap);
      for (const [k, v] of Object.entries(ALWAYS)) t = t.replace(new RegExp(`\\b${k}\\b`, 'g'), v);
      t = t.replace(new RegExp(`((?:\\b[a-z]+\\s+){1,3})(${PLACE_END})\\b`, 'gi'), (m, lead, end) => {
        const words = lead.trim().split(/\s+/);
        let i = words.length;
        while (i > 0 && !STOP.has(words[i - 1].toLowerCase())) i--;
        if (i === words.length) return m; // nothing but "the river": leave it alone
        return words.slice(0, i).concat(words.slice(i).map(cap)).join(' ') + ' ' + cap(end);
      });
      t = t.replace(/\b(llnr|mm|vhf|il|in|wi)\b(?=[\s.,)])/g, (w) => (w === 'in' ? w : w.toUpperCase()));
      t = t.replace(/\b(u\.?s\.?)\s+(army|coast)/g, 'U.S. $2');
      return t.replace(/(^|[.?]\s+)([a-z])/g, (m, p, c) => p + c.toUpperCase());
    }
    function tidyTitle(s) {
      return (s || '').replace(/\s+[—–]\s+/g, ': ').replace(/chicagoharbor/i, 'Chicago Harbor')
        .replace(/lake front/i, 'Lakefront').trim();
    }

    // ── Dates: pull "SEPTEMBER 26, 2026" style dates out of the text so we can
    // say when it happens and move finished events below the current ones.
    const todayKey = new Intl.DateTimeFormat('en-CA', { timeZone: tz }).format(new Date());
    const monthRe = new RegExp(`\\b(${MONTHS.join('|')})\\s+(\\d{1,2})(?:st|nd|rd|th)?(?:,?\\s+(\\d{4}))?`, 'gi');
    function eventDates(n) {
      const fallbackYear = (n.publishedAt || '').slice(0, 4) || todayKey.slice(0, 4);
      const keys = new Set();
      for (const m of (n.summary || '').matchAll(monthRe)) {
        const mo = String(MONTHS.indexOf(m[1].toLowerCase()) + 1).padStart(2, '0');
        keys.add(`${m[3] || fallbackYear}-${mo}-${m[2].padStart(2, '0')}`);
      }
      return [...keys].sort();
    }
    const fmtKey = (k) => dayf.format(new Date(k + 'T12:00:00'));
    function isPast(n, dates) {
      if (!dates.length || dates[dates.length - 1] >= todayKey) return false;
      // A cut-off summary may hide a later end date, so only one-day events
      // are called finished on dates alone.
      const truncated = /…\s*$/.test(n.summary || '');
      return !truncated || /safety zone|marine event/i.test(n.category || '');
    }

    function card(n) {
      let posted = '';
      try { posted = dtf.format(new Date(n.publishedAt)); } catch (e) {}
      const badge = n.source === 'CHSC' ? 'Harbor' : (n.source === 'LNM' ? 'LNM' : 'BNM');
      const d = n._dates;
      const whenTxt = d.length ? (d.length === 1 ? fmtKey(d[0]) : `${fmtKey(d[0])} to ${fmtKey(d[d.length - 1])}`) : '';
      const flag = n._state === 'cancelled' ? '<span class="state-badge canc">Cancelled</span>'
        : n._state === 'past' ? '<span class="state-badge past">Ended</span>' : '';
      return `<article class="notice is-${n._state}">
        <h3>${esc(tidyTitle(n.title))}</h3>
        <p class="notice-meta"><span class="src ${badge.toLowerCase()}">${badge}</span>Posted ${esc(posted)}${flag}</p>
        ${whenTxt ? `<p class="notice-area"><span>When</span> ${esc(whenTxt)}</p>` : ''}
        ${n.summary ? `<p class="notice-sum">${esc(tidy(n.summary))}</p>` : ''}
        ${n.officialUrl ? `<a class="notice-link" href="${esc(n.officialUrl)}" target="_blank" rel="noopener">Read the official notice →</a>` : ''}
      </article>`;
    }

    function prepare(list) {
      return list.map((n) => {
        const _dates = eventDates(n);
        const _state = n.status === 'cancelled' ? 'cancelled' : (isPast(n, _dates) ? 'past' : 'current');
        return { ...n, _dates, _state };
      });
    }

    function render() {
      const list = current === 'all' ? ALL : ALL.filter((n) => n.source === current);
      if (!ALL.length) {
        feed.innerHTML = `<div class="empty"><p class="empty-h">All clear on Chicago waters</p>
          <p class="muted">We checked the last 30 days of notices, and none touch Chicago's harbors, the lakefront, or the river.</p>
          <p><a href="https://www.navcen.uscg.gov/broadcast-notice-to-mariners" target="_blank" rel="noopener">Check the official Coast Guard notices →</a></p></div>`;
        return;
      }
      if (!list.length) {
        const lbl = current === 'CHSC' ? 'Harbor' : current;
        feed.innerHTML = `<p class="feed-msg muted">Nothing under ${lbl} right now. Tap All to see every notice.</p>`; return;
      }
      const live = list.filter((n) => n._state === 'current');
      const done = list.filter((n) => n._state !== 'current');
      feed.innerHTML =
        `<p class="feed-group">In effect &amp; coming up · ${live.length}</p>` +
        (live.length ? live.map(card).join('') : '<p class="feed-msg muted">All clear here. Everything below has wrapped up.</p>') +
        (done.length ? `<p class="feed-group done">Recently ended or cancelled · ${done.length}</p>` + done.map(card).join('') : '');
    }

    filters.addEventListener('click', (e) => {
      const b = e.target.closest('.nfilter'); if (!b) return;
      current = b.dataset.src;
      [...filters.querySelectorAll('.nfilter')].forEach((x) => x.classList.toggle('is-on', x === b));
      render();
    });

    (async () => {
      if (!NOTICES_ENDPOINT) {
        feedMsg.innerHTML = `This feed is being set up. In the meantime, check the
          <a href="https://www.navcen.uscg.gov/broadcast-notice-to-mariners" target="_blank" rel="noopener">official Coast Guard notices</a>.`;
        return;
      }
      try {
        const res = await fetch(`${NOTICES_ENDPOINT}?action=notices`, { method: 'GET' });
        const data = await res.json();
        ALL = prepare((data && data.notices) || []);
        updatedEl.textContent = data && data.updated ? `Updated ${ago(data.updated)}` : '';
        render();
      } catch (err) {
        feedMsg.innerHTML = `The live feed is slow to respond right now. In the meantime, check the
          <a href="https://www.navcen.uscg.gov/broadcast-notice-to-mariners" target="_blank" rel="noopener">official Coast Guard source</a>.`;
      }
    })();
  </script>

  <style>
    .intro-sec { margin-top: 48px; }
    .kicker { text-transform: uppercase; letter-spacing: .18em; font-weight: 700; font-size: 13px; color: var(--blue); margin: 0 0 12px; }
    h1 { font-size: clamp(36px, 6vw, 64px); font-weight: 800; }
    .lede { font-size: 19px; max-width: 640px; }

    .notice-box { margin: 18px 0 8px; padding: 0; overflow: hidden; }
    .callout { padding: 22px 24px 18px; border-bottom: 2px solid var(--ink); background: #fbfaf0; }
    .callout-head { font-family: var(--display); font-weight: 800; font-size: 20px; margin: 0 0 8px; }
    .callout-body { font-size: 15px; line-height: 1.55; margin: 0 0 10px; max-width: 720px; }
    .callout-fine { font-size: 13px; line-height: 1.5; margin: 0 0 6px; }
    .cta-row { margin: 28px 0 0; }
    .cta-line { font-family: var(--display); font-weight: 700; font-size: 18px; margin: 0 0 12px; }
    .callout-fine:last-child { margin-bottom: 0; }

    .filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 14px 24px; border-bottom: 2px solid var(--line); }
    .nfilter { font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: .04em;
               padding: 6px 15px; border-radius: 999px; border: 2px solid var(--ink); background: var(--cream);
               color: var(--ink); cursor: pointer; }
    .nfilter.is-on { background: var(--blue); color: var(--cream); }
    .updated { margin-left: auto; font-size: 12px; }

    .notice-feed { max-height: 620px; overflow-y: auto; padding: 6px 24px 14px; }

    .hero-credit { font-size: 14px; color: #6f6a58; margin: 14px 0 0; font-weight: 600; }
    .hero-credit a { font-weight: 700; color: var(--blue); text-decoration: none; border-bottom: 2px solid transparent; }
    .hero-credit a:hover { border-bottom-color: var(--blue); }

    @media (max-width: 640px) {
      .callout, .filters, .notice-feed { padding-left: 16px; padding-right: 16px; }
      .notice-feed { max-height: none; } /* natural scroll on phones */
      .updated { margin-left: 0; width: 100%; }
    }
  </style>

  <!-- Feed cards are injected at runtime via innerHTML, so they never receive
       Astro's scoping attribute. These rules must be global to reach them. -->
  <style is:global>
    #feed .feed-msg { padding: 26px 0; text-align: center; }
    #feed .notice { padding: 16px 0; border-bottom: 1px solid var(--line); }
    #feed .notice:last-child { border-bottom: none; }
    #feed .notice h3 { font-size: 18px; font-weight: 800; margin: 0 0 6px; line-height: 1.2; }
    #feed .notice-meta { font-size: 12px; color: #8a8470; margin: 0 0 8px; display: flex; align-items: center; gap: 2px; flex-wrap: wrap; }
    #feed .src { font-family: var(--display); font-weight: 700; font-size: 11px; letter-spacing: .05em;
                 padding: 2px 8px; border-radius: 999px; border: 2px solid var(--ink); margin-right: 6px; }
    #feed .src.bnm { background: var(--magenta); color: var(--cream); }
    #feed .src.lnm { background: var(--gold); color: var(--ink); }
    #feed .src.harbor { background: var(--blue); color: var(--cream); }
    #feed .notice-sum { font-size: 14px; line-height: 1.55; margin: 0 0 8px; }
    #feed .notice-area { font-size: 13px; margin: 0 0 8px; color: var(--ink); }
    #feed .notice-area span { font-weight: 700; text-transform: uppercase; letter-spacing: .06em; font-size: 11px; color: #8a8470; margin-right: 4px; }
    #feed .notice-link { font-weight: 700; font-size: 14px; color: var(--blue); }
    #feed .feed-group { font-family: var(--display); font-weight: 800; font-size: 12px; letter-spacing: .12em; text-transform: uppercase;
                        color: var(--blue); margin: 14px 0 0; padding-bottom: 6px; border-bottom: 2px solid var(--ink); }
    #feed .feed-group.done { color: #8a8470; margin-top: 28px; border-bottom-color: var(--line); }
    #feed .notice.is-past, #feed .notice.is-cancelled { opacity: .62; }
    #feed .notice.is-cancelled h3 { text-decoration: line-through; text-decoration-thickness: 2px; text-decoration-color: #b23a3a; }
    #feed .state-badge { font-family: var(--display); font-weight: 700; font-size: 11px; letter-spacing: .05em; text-transform: uppercase;
                         border: 2px solid; border-radius: 999px; padding: 1px 8px; margin-left: 8px; }
    #feed .state-badge.canc { color: #b23a3a; }
    #feed .state-badge.past { color: #8a8470; }
    #feed .empty { padding: 34px 8px; text-align: center; }
    #feed .empty-h { font-family: var(--display); font-weight: 800; font-size: 20px; margin: 0 0 6px; }
    #feed .muted { color: #8a8470; }
  </style>
</Base>
