---
import Base from '../../layouts/Base.astro';
import { people } from '../../people.ts';

export function getStaticPaths() {
  return people.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const person = people.find((p) => p.slug === slug)!;

// Normalize each photo to { src, pos?, offset? } so a plain filename still works.
const photos = person.photos.map((p) => (typeof p === 'string' ? { src: p } : p));
// Split: first 3 go into the overlap stack, the rest into the bottom strip.
const [p1, p2, p3, ...stripPhotos] = photos;

const hasCreds = person.credentials.length > 0;

const description = person.isCaptain
  ? `Meet ${person.cardName}. ${person.tagline ?? ''} Book a private charter aboard Quarters on Lake Michigan.`
  : `Meet ${person.name}, ${person.role.toLowerCase()} with lancha boat, aboard Quarters on Lake Michigan in Chicago.`;
---
<Base title={`${person.cardName} · Crew · lancha boat`} description={description}>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="wrap hero-sec">
    <p class="kicker">ABOARD QUARTERS</p>
    <h1>
      <span class="script-cap">{person.role}</span>
      {person.name}
    </h1>
    {person.tagline && <p class="tagline">{person.tagline}</p>}
  </section>

  <!-- ── MAIN: photo stack left, bio + stats right ─────────────── -->
  <section class="wrap main-sec">

    <!-- Photo stack: up to 3 overlapping images -->
    <div class="stack-col">
      <div class="photo-stack">
        {p1 && (
          <figure class="sp sp1">
            <img src={`/images/${p1.src}.jpg`} alt={`${person.name} aboard Quarters`} style={p1.pos ? `object-position:${p1.pos}` : undefined} />
          </figure>
        )}
        {p2 && (
          <figure class="sp sp2">
            <img src={`/images/${p2.src}.jpg`} alt={`${person.name} on Lake Michigan`} loading="lazy" style={p2.pos ? `object-position:${p2.pos}` : undefined} />
          </figure>
        )}
        {p3 && (
          <figure class="sp sp3">
            <img src={`/images/${p3.src}.jpg`} alt="Aboard Quarters, Chicago" loading="lazy" style={p3.pos ? `object-position:${p3.pos}` : undefined} />
          </figure>
        )}
      </div>
    </div>

    <!-- Bio + stats -->
    <div class="info-col">
      <div class="bio-block">
        <p class="bio-text">{person.bio}</p>
      </div>

      {hasCreds && (
        <div class="card stats-card">
          <p class="stats-kicker">{person.credentialsLabel}</p>
          <ul class="cred-list">
            {person.credentials.map((c) => (
              <li class="cred">{c}</li>
            ))}
          </ul>
        </div>
      )}
    </div>

  </section>

  <!-- ── BOTTOM PHOTO STRIP ────────────────────────────────────── -->
  {stripPhotos.length > 0 && (
    <section class="wrap strip-sec">
      <div class="strip-grid">
        {stripPhotos.map((ph, i) => (
          <figure class={`strip-item si-${i % 3}`} style={ph.offset ? `--ty:${ph.offset}` : undefined}>
            <img src={`/images/${ph.src}.jpg`} alt="Aboard Quarters" loading="lazy" style={ph.pos ? `object-position:${ph.pos}` : undefined} />
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- ── CTA BAND ──────────────────────────────────────────────── -->
  <section class="cta-band">
    <div class="wrap">
      <p class="cta-kicker">READY TO GO?</p>
      {person.isCaptain
        ? <h2>{person.cardName} is available for private charters aboard <em>Quarters</em>.</h2>
        : <h2>Come say hi to {person.name} at the dock, aboard <em>Quarters</em>.</h2>}
      <a class="btn btn-gold" href="/book">Check dates &amp; book →</a>
      <p class="back-link"><a href="/crew">← Meet the whole crew</a></p>
    </div>
  </section>

</Base>

<style>
  /* ── HERO ──────────────────────────────────────────── */
  .hero-sec {
    padding-top: 60px;
    padding-bottom: 0;
  }
  .kicker {
    text-transform: uppercase;
    letter-spacing: .18em;
    font-weight: 700;
    font-size: 13px;
    color: var(--blue);
    margin: 0 0 14px;
  }
  .hero-sec h1 {
    font-size: clamp(52px, 9vw, 96px);
    font-weight: 800;
    line-height: 0.92;
    margin-bottom: 22px;
    letter-spacing: -0.02em;
  }
  /* role in script above the name */
  .script-cap {
    display: block;
    font-family: var(--script);
    font-weight: 400;
    font-size: 0.5em;
    line-height: 1.5;
    color: var(--magenta);
    letter-spacing: 0;
  }
  .tagline {
    font-size: 20px;
    max-width: 580px;
    line-height: 1.45;
    margin: 0;
    color: var(--ink);
  }

  /* ── MAIN GRID ─────────────────────────────────────── */
  .main-sec {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 64px;
    margin-top: 52px;
    align-items: start;
  }

  /* ── PHOTO STACK ───────────────────────────────────── */
  .photo-stack {
    padding: 12px 16px 24px;
  }
  .sp {
    margin: 0;
    overflow: hidden;
    border: 3px solid var(--ink);
    border-radius: 20px;
    display: block;
    position: relative;
  }
  .sp img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top; /* keep heads in frame; per-photo `pos` overrides */
  }

  /* Photo 1: largest, top-left, slight counter-clockwise tilt */
  .sp1 {
    width: 82%;
    aspect-ratio: 3/4;
    transform: rotate(-2.5deg);
    box-shadow: 7px 7px 0 var(--blue);
    z-index: 3;
    margin-left: 0;
  }
  /* Photo 2: medium, right-side, clockwise tilt, overlaps sp1 */
  .sp2 {
    width: 74%;
    aspect-ratio: 3/4;
    transform: rotate(3deg);
    box-shadow: 7px 7px 0 var(--pink);
    z-index: 2;
    margin-top: -64px;
    margin-left: auto;
  }
  /* Photo 3: smallest, lower-center, slight tilt, overlaps both */
  .sp3 {
    width: 66%;
    aspect-ratio: 4/5;
    transform: rotate(-1.5deg);
    box-shadow: 7px 7px 0 var(--gold);
    z-index: 1;
    margin-top: -44px;
    margin-left: 14%;
  }

  /* ── INFO COL ──────────────────────────────────────── */
  .info-col {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 8px;
  }
  .bio-text {
    font-size: 18px;
    line-height: 1.72;
    margin: 0;
  }

  /* ── STATS CARD ────────────────────────────────────── */
  .stats-kicker {
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: 11px;
    font-weight: 700;
    color: var(--blue);
    margin: 0 0 18px;
  }
  .cred-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cred {
    font-family: var(--display);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: .01em;
    line-height: 1.2;
    padding: 7px 13px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink);
  }
  /* Highlight the top credential */
  .cred:first-child {
    background: var(--gold);
  }

  /* ── BOTTOM PHOTO STRIP ────────────────────────────── */
  .strip-sec {
    margin-top: 64px;
  }
  .strip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .strip-item {
    margin: 0;
    border: 3px solid var(--ink);
    border-radius: 20px;
    overflow: hidden;
    /* tilt (--rot per item) + optional vertical scoot (--ty, set inline);
       transform moves the photo without resizing its cell, so nothing clips */
    transform: rotate(var(--rot, 0deg)) translateY(var(--ty, 0px));
  }
  .strip-item img {
    width: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
    aspect-ratio: 4/3;
  }
  .si-0 { box-shadow: 6px 6px 0 var(--magenta); --rot: -1deg; }
  .si-1 { box-shadow: 6px 6px 0 var(--blue);    --rot: 1.5deg; }
  .si-2 { box-shadow: 6px 6px 0 var(--gold);    --rot: -0.8deg; }

  /* ── CTA BAND ──────────────────────────────────────── */
  .cta-band {
    background: var(--blue);
    color: var(--cream);
    padding: 64px 0;
    margin-top: 80px;
    text-align: center;
  }
  .cta-kicker {
    text-transform: uppercase;
    letter-spacing: .18em;
    font-size: 12px;
    font-weight: 700;
    color: var(--pink);
    margin: 0 0 12px;
  }
  .cta-band h2 {
    font-size: clamp(26px, 4vw, 44px);
    color: var(--cream);
    max-width: 640px;
    margin: 0 auto 30px;
  }
  .cta-band em { color: var(--gold); }
  .btn-gold {
    background: var(--gold);
    color: var(--ink);
    border-color: var(--ink);
  }
  .back-link { margin: 22px 0 0; }
  .back-link a { color: var(--cream); font-weight: 600; font-size: 14px; text-decoration: underline; }

  /* ── RESPONSIVE ────────────────────────────────────── */
  @media (max-width: 820px) {
    .main-sec {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .stack-col {
      /* explicit width: margin auto alone makes it shrink-to-fit and the
         percentage-width photos collapse to zero on mobile */
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
    }
    .sp1 { width: 88%; }
    .sp2 { width: 78%; margin-top: -56px; }
    .sp3 { width: 68%; margin-top: -38px; }
    .strip-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 500px) {
    .strip-grid { grid-template-columns: 1fr; }
  }
</style>
