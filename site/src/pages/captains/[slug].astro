---
import Base from '../../layouts/Base.astro';
import { captains } from '../../captains.ts';

export function getStaticPaths() {
  return captains.map((cap) => ({ params: { slug: cap.slug } }));
}

const { slug } = Astro.params;
const cap = captains.find((c) => c.slug === slug)!;

// Split photos: first 3 go into the overlap stack, rest go in the bottom strip.
const [p1, p2, p3, ...stripPhotos] = cap.photos;
---
<Base
  title={`${cap.handle} · Captains · lancha boat`}
  description={`Meet ${cap.handle}. ${cap.tagline} Book a private charter aboard Quarters on Lake Michigan.`}
>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="wrap hero-sec">
    <p class="kicker">ABOARD QUARTERS</p>
    <h1>
      <span class="script-cap">Captain</span>
      {cap.name}
    </h1>
    <p class="tagline">{cap.tagline}</p>
  </section>

  <!-- ── MAIN: photo stack left, bio + stats right ─────────────── -->
  <section class="wrap main-sec">

    <!-- Photo stack: 3 overlapping images -->
    <div class="stack-col">
      <div class="photo-stack">
        <figure class="sp sp1">
          <img src={`/images/${p1}.jpg`} alt={`${cap.handle} aboard Quarters`} />
        </figure>
        <figure class="sp sp2">
          <img src={`/images/${p2}.jpg`} alt={`${cap.handle} on Lake Michigan`} loading="lazy" />
        </figure>
        <figure class="sp sp3">
          <img src={`/images/${p3}.jpg`} alt="Aboard Quarters, Chicago" loading="lazy" />
        </figure>
      </div>
    </div>

    <!-- Bio + stats -->
    <div class="info-col">
      <div class="bio-block">
        <p class="bio-text">{cap.bio}</p>
      </div>

      <div class="card stats-card">
        <p class="stats-kicker">The details</p>
        <ul class="stats-list">
          <li>
            <span class="stat-key">License</span>
            <span class="stat-val">{cap.license}</span>
          </li>
          <li>
            <span class="stat-key">On the water</span>
            <span class="stat-val">{cap.years}</span>
          </li>
          <li>
            <span class="stat-key">Home waters</span>
            <span class="stat-val">{cap.homeWaters}</span>
          </li>
          <li>
            <span class="stat-key">Certifications</span>
            <span class="stat-val">{cap.certs.join(' · ')}</span>
          </li>
          <li>
            <span class="stat-key">Favorite route</span>
            <span class="stat-val">{cap.favoriteRoute}</span>
          </li>
          {cap.extraStats?.map((s) => (
            <li>
              <span class="stat-key">{s.label}</span>
              <span class="stat-val">{s.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

  </section>

  <!-- ── BOTTOM PHOTO STRIP ────────────────────────────────────── -->
  {stripPhotos.length > 0 && (
    <section class="wrap strip-sec">
      <div class="strip-grid">
        {stripPhotos.map((ph, i) => (
          <figure class={`strip-item si-${i % 3}`}>
            <img src={`/images/${ph}.jpg`} alt="Aboard Quarters" loading="lazy" />
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- ── CTA BAND ──────────────────────────────────────────────── -->
  <section class="cta-band">
    <div class="wrap">
      <p class="cta-kicker">READY TO GO?</p>
      <h2>{cap.handle} is available for private charters aboard <em>Quarters</em>.</h2>
      <a class="btn btn-gold" href="/book">Check dates &amp; book →</a>
    </div>
  </section>

</Base>

<style>
  /* ── HERO ──────────────────────────────────────────── */
  .hero-sec {
    padding-top: 60px;
    padding-bottom: 0;
  }
  .kicker {
    text-transform: uppercase;
    letter-spacing: .18em;
    font-weight: 700;
    font-size: 13px;
    color: var(--blue);
    margin: 0 0 14px;
  }
  .hero-sec h1 {
    font-size: clamp(52px, 9vw, 96px);
    font-weight: 800;
    line-height: 0.92;
    margin-bottom: 22px;
    letter-spacing: -0.02em;
  }
  /* "Captain" in script above the name */
  .script-cap {
    display: block;
    font-family: var(--script);
    font-weight: 400;
    font-size: 0.5em;
    line-height: 1.5;
    color: var(--magenta);
    letter-spacing: 0;
  }
  .tagline {
    font-size: 20px;
    max-width: 580px;
    line-height: 1.45;
    margin: 0;
    color: var(--ink);
  }

  /* ── MAIN GRID ─────────────────────────────────────── */
  .main-sec {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 64px;
    margin-top: 52px;
    align-items: start;
  }

  /* ── PHOTO STACK ───────────────────────────────────── */
  .photo-stack {
    /* overflow:visible so rotated shadows show */
    padding: 12px 16px 24px;
  }
  .sp {
    margin: 0;
    overflow: hidden;
    border: 3px solid var(--ink);
    border-radius: 20px;
    display: block;
    position: relative;
  }
  .sp img {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  /* Photo 1: largest, top-left, slight counter-clockwise tilt */
  .sp1 {
    width: 82%;
    aspect-ratio: 3/4;
    transform: rotate(-2.5deg);
    box-shadow: 7px 7px 0 var(--blue);
    z-index: 3;
    margin-left: 0;
  }
  /* Photo 2: medium, right-side, clockwise tilt, overlaps sp1 */
  .sp2 {
    width: 74%;
    aspect-ratio: 3/4;
    transform: rotate(3deg);
    box-shadow: 7px 7px 0 var(--pink);
    z-index: 2;
    margin-top: -130px;
    margin-left: auto;
  }
  /* Photo 3: smallest, lower-center, slight tilt, overlaps both */
  .sp3 {
    width: 66%;
    aspect-ratio: 4/5;
    transform: rotate(-1.5deg);
    box-shadow: 7px 7px 0 var(--gold);
    z-index: 1;
    margin-top: -90px;
    margin-left: 14%;
  }

  /* ── INFO COL ──────────────────────────────────────── */
  .info-col {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 8px;
  }
  .bio-text {
    font-size: 18px;
    line-height: 1.72;
    margin: 0;
  }

  /* ── STATS CARD ────────────────────────────────────── */
  .stats-kicker {
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: 11px;
    font-weight: 700;
    color: var(--blue);
    margin: 0 0 18px;
  }
  .stats-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .stats-list li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .stats-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .stat-key {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: #8a8470;
    padding-top: 2px;
  }
  .stat-val {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* ── BOTTOM PHOTO STRIP ────────────────────────────── */
  .strip-sec {
    margin-top: 64px;
  }
  .strip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .strip-item {
    margin: 0;
    border: 3px solid var(--ink);
    border-radius: 20px;
    overflow: hidden;
  }
  .strip-item img {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 4/3;
  }
  /* Alternating shadows + micro-tilts for visual interest */
  .si-0 { box-shadow: 6px 6px 0 var(--magenta); transform: rotate(-1deg); }
  .si-1 { box-shadow: 6px 6px 0 var(--blue);    transform: rotate(1.5deg); }
  .si-2 { box-shadow: 6px 6px 0 var(--gold);    transform: rotate(-0.8deg); }

  /* ── CTA BAND ──────────────────────────────────────── */
  .cta-band {
    background: var(--blue);
    color: var(--cream);
    padding: 64px 0;
    margin-top: 80px;
    text-align: center;
  }
  .cta-kicker {
    text-transform: uppercase;
    letter-spacing: .18em;
    font-size: 12px;
    font-weight: 700;
    color: var(--pink);
    margin: 0 0 12px;
  }
  .cta-band h2 {
    font-size: clamp(26px, 4vw, 44px);
    color: var(--cream);
    margin-bottom: 30px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 30px;
  }
  .cta-band em {
    color: var(--gold);
  }
  .btn-gold {
    background: var(--gold);
    color: var(--ink);
    border-color: var(--ink);
  }

  /* ── RESPONSIVE ────────────────────────────────────── */
  @media (max-width: 820px) {
    .main-sec {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .stack-col {
      /* cap the stack height on mobile */
      max-width: 480px;
      margin: 0 auto;
    }
    .sp1 { width: 88%; }
    .sp2 { width: 78%; margin-top: -100px; }
    .sp3 { width: 68%; margin-top: -70px; }
    .strip-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 500px) {
    .strip-grid { grid-template-columns: 1fr; }
    .stats-list li { grid-template-columns: 1fr; gap: 3px; }
    .stat-key { padding-top: 0; }
  }
</style>
