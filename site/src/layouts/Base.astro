---
const {
  title = 'lancha boat · private charters aboard Quarters',
  description = 'Private boat charters on Lake Michigan aboard Quarters. Good times on water, chill with friends & fam, bring your own whatever — based in Chicago at Diversey Harbor.',
  image = '/og.jpg',
} = Astro.props;
const ticker = 'GOOD TIMES → ON WATER  •  CHILL WITH → FRIENDS & FAM  •  BRING YOUR OWN → WHATEVER  •  ';
const base = Astro.site ?? new URL('https://lanchaboat.com');
const canonical = Astro.url ? new URL(Astro.url.pathname, base).href : undefined;
const ogImage = image.startsWith('http') ? image : new URL(image, base).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="lancha boat" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body>
    <!-- scrolling ticker -->
    <div class="ticker"><div class="ticker-track">{ticker.repeat(6)}</div></div>

    <header class="nav">
      <a class="logo" href="/" aria-label="lancha boat home">
        <img src="/brand/logolockup_blitz.svg" alt="lancha boat" class="logo-svg" width="158" height="44" />
      </a>
      <nav>
        <a href="/#how">How it works</a>
        <a href="/#inquire">Questions</a>
        <a class="btn btn-sm" href="/book">Book now</a>
      </nav>
    </header>

    <slot />

    <footer class="footer">
      <div class="foot-logo"><img src="/brand/logolockup_80black.svg" alt="lancha boat" class="logo-svg logo-svg--footer" width="158" height="44" /></div>
      <p>Private charters aboard <em>Quarters</em> · Diversey Harbor · K-Dock, Slip 8 · Chicago</p>
      <p class="muted">Operated under a bareboat / demise charter model in compliance with USCG vessel safety standards.</p>
      <span class="builtby">
        <span class="builtby-label">Built by</span>
        <img class="rr-logo" src="/road-ready-safety.png" alt="Road Ready Safety" width="140" height="35" />
      </span>
    </footer>

    <style is:global>
      /* ── Brand fonts (self-hosted, variable) ─────────────────────────── */
      @font-face {
        font-family: 'Zalando Sans';
        src: url('/fonts/ZalandoSans-Variable.ttf') format('truetype');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Zalando Sans';
        src: url('/fonts/ZalandoSans-Variable-Italic.ttf') format('truetype');
        font-weight: 100 900;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'Zalando Sans Expanded';
        src: url('/fonts/ZalandoSansExpanded-Variable.ttf') format('truetype');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Covered By Your Grace';
        src: url('/fonts/CoveredByYourGrace-Regular.ttf') format('truetype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --cream:   #FFFDEF;  /* sunrise — background base */
        --ink:     #333333;  /* 80% blackout — text/borders */
        --blue:    #444AEB;  /* chi vice — primary */
        --pink:    #EC82EA;  /* bazooka — soft accent */
        --magenta: #E81C8E;  /* blitz — hot accent */
        --gold:    #FFD600;  /* pop of summer — highlight */
        --line:    #e7e3cf;
        --sans:    'Zalando Sans', system-ui, sans-serif;
        --display: 'Zalando Sans Expanded', 'Zalando Sans', system-ui, sans-serif;
        --script:  'Covered By Your Grace', cursive;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: var(--sans); color: var(--ink); background: var(--cream); line-height: 1.55; }
      h1, h2, h3 { font-family: var(--display); line-height: 1.02; letter-spacing: -0.01em; margin: 0 0 12px; }
      a { color: var(--blue); }
      .muted { color: #8a8470; }
      em { font-style: normal; color: var(--magenta); }

      /* ticker */
      .ticker { background: var(--blue); overflow: hidden; white-space: nowrap; }
      .ticker-track {
        display: inline-block; padding: 7px 0; color: var(--cream);
        font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: .06em;
        animation: scroll 38s linear infinite;
      }
      @keyframes scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

      /* logo lockup */
      .logo { display: inline-flex; align-items: center; text-decoration: none; }
      .logo-svg { height: 36px; width: auto; display: block; }
      .logo-svg--footer { height: 32px; filter: brightness(0) invert(1); }

      /* nav */
      .nav { display: flex; align-items: center; justify-content: space-between; padding: 14px 24px;
             background: var(--cream); border-bottom: 2px solid var(--ink); position: sticky; top: 0; z-index: 20; }
      .nav nav { display: flex; align-items: center; gap: 22px; }
      .nav nav a { color: var(--ink); text-decoration: none; font-weight: 600; font-size: 15px; }
      .nav nav a:not(.btn):hover { color: var(--blue); }
      /* keep the CTA button's own colors (more specific than .nav nav a) */
      .nav nav a.btn { color: var(--cream); }
      .nav nav a.btn.gold { color: var(--ink); }

      /* buttons */
      .btn { display: inline-block; background: var(--blue); color: var(--cream); font-family: var(--display); font-weight: 700;
             padding: 14px 26px; border-radius: 999px; text-decoration: none; border: 2px solid var(--ink); cursor: pointer;
             font-size: 16px; box-shadow: 3px 3px 0 var(--ink); transition: transform .06s ease, box-shadow .06s ease; }
      .btn:hover { transform: translate(-1px,-1px); box-shadow: 4px 4px 0 var(--ink); }
      .btn:active { transform: translate(2px,2px); box-shadow: 1px 1px 0 var(--ink); }
      .btn-sm { padding: 9px 18px; font-size: 14px; box-shadow: 2px 2px 0 var(--ink); }
      .btn.pink { background: var(--magenta); }
      .btn.gold { background: var(--gold); color: var(--ink); }
      .btn[disabled] { opacity: .45; cursor: not-allowed; box-shadow: none; transform: none; }

      .wrap { max-width: 1000px; margin: 0 auto; padding: 0 24px; }
      .card { background: #fff; border: 2px solid var(--ink); border-radius: 18px; padding: 24px; box-shadow: 4px 4px 0 var(--ink); }

      /* footer */
      .footer { background: var(--blue); color: var(--cream); text-align: center; padding: 44px 24px; margin-top: 72px; }
      .foot-logo { margin-bottom: 10px; }
      .footer p { margin: 5px 0; font-size: 14px; }
      .footer .muted { color: #cfd2ff; }
      .footer em { color: var(--gold); }
      .builtby { display: inline-flex; align-items: center; gap: 10px; margin-top: 20px;
                 background: #fff; padding: 8px 16px; border-radius: 999px; }
      .builtby-label { color: #6b7280; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
      .builtby .rr-logo { height: 24px; width: auto; display: block; }

      /* mobile nav: drop the text links, keep logo + CTA */
      @media (max-width: 640px) {
        .nav { padding: 12px 16px; }
        .nav nav { gap: 12px; }
        .nav nav a:not(.btn) { display: none; }
        .logo-svg { height: 28px; }
        .ticker-track { font-size: 12px; }
      }
    </style>
  </body>
</html>
